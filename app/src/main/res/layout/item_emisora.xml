<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_panel"
    android:padding="14dp">

    <!-- Nombre e información de la emisora (igual que antes) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombreEmisora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/motero_texto"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtInfoEmisora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/motero_texto_tenue"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Estrella: tocarla agrega o quita la emisora de "Mis favoritas".
         focusable=false para que tocar el resto de la fila siga reproduciendo. -->
    <TextView
        android:id="@+id/btnFavorita"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="☆"
        android:textColor="@color/motero_texto_tenue"
        android:textSize="26sp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Favorita" />
</LinearLayout>
