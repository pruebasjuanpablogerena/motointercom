<resources>
    <style name="Theme.MotoIntercom" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/motero_acento</item>
        <item name="colorPrimaryDark">@color/motero_fondo</item>
        <item name="colorAccent">@color/motero_acento</item>
        <item name="android:windowBackground">@color/motero_fondo</item>
    </style>

    <style name="BotonMotero" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_boton</item>
        <item name="android:textColor">@color/motero_texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="BotonMoteroAlerta" parent="BotonMotero">
        <item name="android:background">@drawable/bg_boton_alerta</item>
    </style>
</resources>
