<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- neverForLocation: la app NO usa el Bluetooth para saber dónde estás. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Solo para Android 11 o anterior. Ya no se pide la ubicación: la app se
         conecta a celulares ya emparejados y no necesita buscar dispositivos. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Para leer el código QR de una sala. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".MotoIntercomApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MotoIntercom"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de la cámara que lee el QR de la sala (viene de la librería
             zxing-android-embedded). Se deja girar libre para que se vea derecha
             en un celular vertical. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <activity
            android:name=".RadioActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SalaInternetActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="motointercom" android:host="sala" />
            </intent-filter>
        </activity>

        <!-- Permite compartir la imagen del QR de la sala con WhatsApp y otras apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_compartir" />
        </provider>

        <!--
          Mantiene la sala por internet conectada y recibiendo audios en
          segundo plano, aunque se cierre esta pantalla o se use otra app.
        -->
        <!-- Deja la radio sonando fuera de su pantalla (con notificación y botón "Apagar radio"). -->
        <service
            android:name=".RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".SalaInternetService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />

        <!--
          Este servicio mantiene viva la llamada (Bluetooth + micrófono) aunque
          la pantalla de MotoIntercom pase a segundo plano, por ejemplo al abrir
          Spotify para compartir música. Reemplaza al antiguo CapturaAudioService.
        -->
        <service
            android:name=".IntercomService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice|mediaProjection" />

    </application>

</manifest>
